---
import Layout from '../layouts/Layout.astro'
import TFlex from '../components/templates/TFlex.vue'
import OIntro from '../components/organisms/OIntro.vue'
import OSelfDescription from '../components/organisms/OSelfDescription.vue'
import OFloatingNav from '../components/organisms/OFloatingNav.vue'
import OLanguages from '../components/organisms/OLanguages.vue'
import OCurriculum from '../components/organisms/OCurriculum.vue'
import OFreelanceReferences from '../components/organisms/OFreelanceReferences.vue'
import OCapabilities from '../components/organisms/OCapabilities.vue'
import OOpenSourceSection from '../components/organisms/OOpenSourceSection.vue'
import AGithubCTA from '../components/atoms/AGithubCTA.vue'
import QNoPrint from '../components/quarks/QNoPrint.vue'
import QPagebreak from '../components/quarks/QPagebreak.vue'
import OTechstack from '../components/organisms/OTechstack.vue'
---

<Layout>
  <TFlex
    column={true}
    spacious={true}
  >
    <OFloatingNav/>

    <OIntro id="intro"/>

    <OSelfDescription id="description"/>

    <hr>

    <OCurriculum id="curriculum" primary={true}/>

    <QNoPrint>
      <hr>

      <div slot="yes">
        <p style="margin-top: 1.5rem;">Barthy Bonhomme: page 1 of 3</p>
      </div>
    </QNoPrint>

    <QPagebreak/>

    <OCurriculum/>

    <QNoPrint>
      <hr>

      <div slot="yes">
        <p style="margin-top: 0rem;">Barthy Bonhomme: page 2 of 3</p>
      </div>
    </QNoPrint>

    <QPagebreak/>

    <OCapabilities id="capabilities"/>

    <OTechstack id="techstack"/>

    <QNoPrint>
      <hr>

      <div slot="yes">
        <p style="max-width: unset; margin-top: 1rem;">
          Barthy Bonhomme: page 3 of 3 — Save paper & ink<br>If you really need a printed
          copy, find a black on white version in the print dialog at
          <a href="https://barthy.koeln">https://barthy.koeln</a>
        </p>
      </div>
    </QNoPrint>

    <QPagebreak/>

    <QNoPrint>
      <OFreelanceReferences id="freelance"/>

      <hr>

      <OOpenSourceSection id="open-source"/>

      <hr>

      <AGithubCTA/>
    </QNoPrint>
  </TFlex>
</Layout>
